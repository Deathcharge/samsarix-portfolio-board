{
  "name": "samsarix-portfolio-board",
  "version": "1.1.0",
  "description": "Read-only GitHub portfolio operations dashboard from Samsarix LLC",
  "license": "Apache-2.0",
  "author": {
    "name": "Samsarix LLC",
    "email": "contact@samsarix.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deathcharge/samsarix-portfolio-board.git"
  },
  "bugs": {
    "url": "https://github.com/Deathcharge/samsarix-portfolio-board/issues",
    "email": "support@samsarix.com"
  },
  "homepage": "https://github.com/Deathcharge/samsarix-portfolio-board#readme",
  "keywords": [
    "samsarix",
    "github",
    "portfolio",
    "operations",
    "repository-standards",
    "dashboard",
    "repository"
  ],
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "express-rate-limit": "^8.6.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^8.2.1"
  }
}
