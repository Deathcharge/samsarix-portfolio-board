# Bind to loopback by default. Set HOST=0.0.0.0 only behind an intended network boundary.
HOST=127.0.0.1
PORT=5000

# Per-process IP rate limit. Set TRUST_PROXY_HOPS to the exact number of trusted
# reverse-proxy hops only when the app is not directly reachable.
TRUST_PROXY_HOPS=0
REQUEST_RATE_LIMIT_MAX=300
REQUEST_RATE_LIMIT_WINDOW_SECONDS=60

# Public GitHub account whose repositories should be shown.
GITHUB_OWNER=Deathcharge
GITHUB_ACCOUNT_TYPE=user

# Follow GitHub pagination up to this ceiling (1-300).
GITHUB_MAX_REPOSITORIES=100

# Optional: a comma-separated subset of repository names from the fetched results.
# GITHUB_REPOS=samsarix-integration-guard,samsarix-narrative-engine

# Optional: fine-grained token with read-only Metadata permission.
# When a token is present, community-profile enrichment defaults to enabled.
# GITHUB_TOKEN=

# Optional contributor-readiness checks. Enabling this requires GITHUB_TOKEN.
# GITHUB_COMMUNITY_PROFILE=true
GITHUB_COMMUNITY_PROFILE_TTL_SECONDS=3600
GITHUB_COMMUNITY_CONCURRENCY=4

# Repositories pushed within this many days are labelled active rather than quiet.
ACTIVITY_WINDOW_DAYS=90

# Successful GitHub responses are cached to bound API usage.
CACHE_TTL_SECONDS=300
STALE_MAX_AGE_SECONDS=86400
GITHUB_TIMEOUT_MS=8000
